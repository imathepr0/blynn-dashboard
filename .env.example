# Copia este archivo como `.env.local` y ajusta los valores.
# `.env.local` NUNCA se sube a Git (está en .gitignore).

# Dirección del backend de Blynn (incluye /api/v1).
# - Desarrollo: si no la defines, se usa http://localhost:8000/api/v1
# - Producción: es OBLIGATORIA y debe empezar con https://
#   (sin ella la app muestra un aviso de configuración en vez de conectarse a ciegas)
VITE_API_URL=http://localhost:8000/api/v1
