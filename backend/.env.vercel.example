# Variables de entorno del backend en Vercel (Project Settings -> Environment Variables).
# NUNCA subas un .env real al repositorio. Este archivo es solo una guía.

ENVIRONMENT=production

# Supabase -> Connect -> "Transaction pooler" (puerto 6543). Reemplaza [YOUR-PASSWORD]; si la
# contraseña tiene @ # / : ? % hay que codificarlos (@ -> %40). Las migraciones se corren desde
# tu computador con el "Session pooler" (puerto 5432), ver README.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Una conexión por petición: en funciones serverless un pool no sirve y agota las conexiones.
DB_USE_NULL_POOL=true

# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Dirección EXACTA del frontend (https, sin barra final), en formato lista JSON.
CORS_ORIGINS=["https://TU-FRONTEND.vercel.app"]

# Escáner de boletas en Render. Sin OCR_SERVICE_KEY mientras el escáner siga sin exigirla.
OCR_SERVICE_URL=https://escaner-de-boletas-cl.onrender.com
OCR_SERVICE_TIMEOUT_SECONDS=180

# Cabecera con la IP real del cliente (si no, todos los usuarios compartirían la IP del proxy y
# el límite por IP los bloquearía a todos juntos). Después de desplegar, COMPRUEBA que no se
# puede falsificar: python tools/verificar_despliegue.py --api https://TU-BACKEND.vercel.app ...
TRUSTED_CLIENT_IP_HEADER=x-real-ip
