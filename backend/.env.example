# Copia este archivo como `.env` (dentro de backend/) y completa los valores.
# `.env` NUNCA se sube a Git (ver backend/.gitignore).

# "development" o "production". En producción el servidor exige más
# (DATABASE_URL obligatoria, CORS sin "*").
ENVIRONMENT=development

# --- Base de datos (Supabase) ---
# Pega aquí la cadena de conexión de Supabase (Connect -> "Session pooler"
# para correr migraciones; ver README, sección "Base de datos y Supabase").
# Si la contraseña tiene caracteres especiales (@ # / : ? %), hay que
# codificarlos (p. ej. @ -> %40).
DATABASE_URL=

# --- Autenticación ---
# OBLIGATORIA. Al menos 32 caracteres, aleatoria y secreta. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Si la cambias, todas las sesiones abiertas dejan de servir.
JWT_SECRET_KEY=

# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# BCRYPT_ROUNDS=12

# --- CORS: orígenes del frontend (formato JSON) ---
# CORS_ORIGINS=["http://localhost:5173"]

# --- Escaneo de boletas (Etapa 4) ---
# Dirección BASE del servicio de escaneo, sin ruta. Vacía = escaneo
# desactivado (el endpoint responde 503). En producción debe ser https://.
# OCR_SERVICE_URL=https://escaner-de-boletas-cl.onrender.com
# Clave compartida (cabecera X-Service-Key). Déjala vacía mientras el escáner
# siga público; cuando él la exija, pon la misma aquí (mínimo 24 caracteres).
# Genérala con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# OCR_SERVICE_KEY=
# Tiempo máximo total de un escaneo, incluido despertar el servicio (Render
# lo duerme por inactividad):
# Debe ser MAYOR que el límite del escáner (ver README); recomendado fijar allá
# MAX_PROCESSING_TIME_SECONDS=90.
# OCR_SERVICE_TIMEOUT_SECONDS=180
# Cupo por usuario (cada foto cuesta hasta 30 s de CPU del escáner):
# OCR_MAX_ESCANEOS_POR_USUARIO=10
# OCR_RATE_LIMIT_WINDOW_SECONDS=600

